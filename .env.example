BOT_TOKEN=replace_with_your_botfather_token
DATABASE_PATH=data/app.db
REMINDER_CHECK_INTERVAL=60
BASE_REMINDER_TIME=16:00
BASE_TIMEZONE=Europe/Moscow
TARGET_CURRENCY=RUB
CURRENCY_ROUNDING=precise
# Set your own Telegram ID before starting the bot. If left empty, the first
# person to send /start to a fresh database becomes the administrator.
ADMIN_IDS=
# Optional, for servers whose network blocks Telegram: a proxy for Telegram
# traffic (socks5://host:port, socks4://host:port or http://host:port; add
# user:password@ before the host if needed) or another Bot API server URL.
TELEGRAM_PROXY=
TELEGRAM_API_URL=
